[194.9492, "o", "  \u001b[2m│\u001b[22m \u001b[38;2;46;125;79m✓\u001b[0m every seeded violation caught                           \u001b[2m44\u001b[22m \u001b[2m│\u001b[22m\r\n  \u001b[2m│\u001b[22m \u001b[38;2;46;125;79m✓\u001b[0m no finding on a line marked good                           \u001b[2m│\u001b[22m\r\n  \u001b[2m╰──────────────────────────────────────────────────────────────╯\u001b[22m\r\n  \u001b[2m╭─ \u001b[22m\u001b[1mMutants\u001b[22m\u001b[2m ─────────────────────────────────────────────\u001b[22m 17/17\u001b[2m─╮\u001b[22m\r\n  \u001b[2m│\u001b[22m \u001b[38;2;46;125;79m✓\u001b[0m every mutant makes its rule fire                        \u001b[2m17\u001b[22m \u001b[2m│\u001b[22m\r\n  \u001b[2m╰──────────────────────────────────────────────────────────────╯\u001b[22m\r\n\r\n"]
[194.9492, "o", "\u001b[1;48;2;253;218;36;38;2;21;19;15m PASSED \u001b[0m  \u001b[1mxplint catches everything it should.\u001b[22m   \u001b[2m3:15\u001b[22m\r\n\r\n  \u001b[2mevery rule and mutant:\u001b[22m  make lint-selftest DETAILS=1\r\n"]
