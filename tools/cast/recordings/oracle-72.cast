[11.0911, "o", "  \u001b[2m│\u001b[22m \u001b[38;2;46;125;79m✓\u001b[0m found every fact in the ledger                             \u001b[2m│\u001b[22m\r\n  \u001b[2m╰──────────────────────────────────────────────────────────────╯\u001b[22m\r\n  \u001b[2m╭─ \u001b[22m\u001b[1mPlanted errors (one digit changed)\u001b[22m\u001b[2m ──────────────────\u001b[22m 51/51\u001b[2m─╮\u001b[22m\r\n  \u001b[2m│\u001b[22m \u001b[38;2;46;125;79m✓\u001b[0m 51 rejected by both readers                                \u001b[2m│\u001b[22m\r\n"]
