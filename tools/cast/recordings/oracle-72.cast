[11.0912, "o", "\u001b[1;48;2;253;218;36;38;2;21;19;15m PASSED \u001b[0m  \u001b[1mEvery fact is confirmed by two readers.\u001b[22m   \u001b[2m11s\u001b[22m\r\n\r\n"]
