[14.3629, "o", "  \u001b[2m│\u001b[22m \u001b[38;2;46;125;79m✓\u001b[0m found every fact in its printout                           \u001b[2m│\u001b[22m\r\n  \u001b[2m╰──────────────────────────────────────────────────────────────╯\u001b[22m\r\n  \u001b[2m╭─ \u001b[22m\u001b[1mSchema walker\u001b[22m\u001b[2m ─────────────────────────────────────\u001b[22m 737/737\u001b[2m─╮\u001b[22m\r\n  \u001b[2m│\u001b[22m \u001b[38;2;46;125;79m✓\u001b[0m found every fact in the ledger                             \u001b[2m│\u001b[22m\r\n  \u001b[2m╰──────────────────────────────────────────────────────────────╯\u001b[22m\r\n  \u001b[2m╭─ \u001b[22m\u001b[1mPlanted errors (one digit changed)\u001b[22m\u001b[2m ──────────────────\u001b[22m 49/49\u001b[2m─╮\u001b[22m\r\n"]
