20":3,"2421":3,"2422":3,"2423":3,"2424":9,"2425":9,"2426":9,"2427":9,"2428":9,"2429":9,"2430":4,"2431":4,"2432":7,"2433":4,"2434":4,"2435":4,"2436":7,"2437":7,"2438":7,"2439":7,"2440":7,"2441":7,"2442":3,"2443":3,"2444":9,"2445":8,"2446":5,"2447":6,"2448":6,"2449":7,"2450":4,"2451":4,"2452":4,"2453":7,"2454":3,"2455":3,"2456":3,"2457":9,"2458":8,"2459":5,"2460":6,"2461":6,"2462":6,"2463":7,"2464":4,"2465":4,"2466":4,"2467":4,"2468":4,"2469":4,"2470":4,"2471":4,"2472":4,"2473":4,"2474":4,"2475":4,"2476":4,"2477":4,"2478":4,"2479":4,"2480":4,"2481":4,"2482":7,"2483":7,"2484":7,"2485":3,"2486":3,"2487":6,"2488":4,"2489":5,"2490":9,"2491":8,"2492":6,"2493":5,"2494":6,"2495":8,"2496":4,"2497":3,"2498":3,"2499":4,"2500":5,"2501":9,"2502":8,"2503":6,"2504":5,"2505":6,"2506":8,"2507":4}},"unstoredValues":{},"unstoredTerms":{}},"docs":{"docs":{"1":{"id":"/docs/corpus/catalog","page_id":"/docs/corpus/catalog","type":"page","content":"Catalog","breadcrumbs":["Docs","Corpus","Making entries"],"tags":[],"url":"/docs/corpus/catalog"},"2":{"id":"/docs/corpus/catalog-0","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog","content":"One hand-written file per entry: what it is for, which recipe step holds it, and the facts a correct reader must find. A compiler turns it into the entry, for every variant, and refuses any fact that doesn't hold."},"3":{"id":"/docs/corpus/catalog-1","page_id":"/docs/corpus/catalog","type":"heading","tags":[],"url":"/docs/corpus/catalog#write-the-intent","content":"Write the intent"},"4":{"id":"/docs/corpus/catalog-2","page_id":"/docs/corpus/catalog","type":"heading","tags":[],"url":"/docs/corpus/catalog#compile-it","content":"Compile it"},"5":{"id":"/docs/corpus/catalog-3","page_id":"/docs/corpus/catalog","type":"heading","tags":[],"url":"/docs/corpus/catalog#check-it","content":"Check it"},"6":{"id":"/docs/corpus/catalog-4","page_id":"/docs/corpus/catalog","type":"heading","tags":[],"url":"/docs/corpus/catalog#fact-addresses","content":"Fact addresses"},"7":{"id":"/docs/corpus/catalog-5","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog","content":"**What it is.** The hand-written source of every entry: what it is for, where its ledger comes from, and the facts to check. A compiler turns it into the entry."},"8":{"id":"/docs/corpus/catalog-6","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog","content":"**Why it matters.** Nobody edits the corpus by hand, and the compiler refuses any fact that doesn't hold, so a typo can't become a wrong answer."},"9":{"id":"/docs/corpus/catalog-7","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog","content":"Nobody edits `entries/` by hand. Each entry starts as a **catalog file**, `catalog/<id>.json`. It says what the entry is for, where its ledger comes from, and the facts a correct reader must find, written relative to the transaction the entry is about. The compiler, `tools/build.mjs`, turns it into `entries/<id>/` for every variant."},"10":{"id":"/docs/corpus/catalog-8","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#write-the-intent","content":"A catalog file carries:"},"11":{"id":"/docs/corpus/catalog-9","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#write-the-intent","content":"the id, title and pattern;"},"12":{"id":"/docs/corpus/catalog-10","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#write-the-intent","content":"the CAPs, and the hazards with their placement;"},"13":{"id":"/docs/corpus/catalog-11","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#write-the-intent","content":"the source: a recipe lane and step, or a mined ledger;"},"14":{"id":"/docs/corpus/catalog-12","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#write-the-intent","content":"the variants to build, such as `p30-mainnet`, `p28-testnet` or `p30-mainnet-galexie`, and optionally mined variants beside the generated ones;"},"15":{"id":"/docs/corpus/catalog-13","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#write-the-intent","content":"the focus: an operation of the step's transaction, or `{\"ledger\": true}` when the entry is about the ledger itself. A mined entry names its transaction by hash; the compiler never picks one;"},"16":{"id":"/docs/corpus/catalog-14","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#write-the-intent","content":"the facts."},"17":{"id":"/docs/corpus/catalog-15","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#compile-it","content":"The compiler takes the ledger bytes from a fresh `make generate` run (or from `mined/`) and finds the focus transaction. It resolves every fact into an exact JSON Pointer for that variant, and records size, sha256, provenance and change-order data. It needs the runs of `make generate`, for the base P30 mainnet variants also those of `make order-scan` (it ships the most frequent byte ordering), and the native reader (`make native`). A fact that doesn't hold fails the build, and so does a variant whose focus doesn't match the catalog's (a transaction where the catalog says ledger, or none where it names one): intent and outcome must agree before an entry exists."},"18":{"id":"/docs/corpus/catalog-16","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#check-it","content":"`make verify` and `make oracle` check the built entries like any other. `make novelty` then fails if the new entry adds nothing another entry doesn't already hold."},"19":{"id":"/docs/corpus/catalog-17","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"A fact names where it looks with `at`. The compiler resolves that address per variant, so one catalog file serves every protocol, network and flag profile."},"20":{"id":"/docs/corpus/catalog-18","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"| `at`        | Resolves to                    |\n| ----------- | ------------------------------ |\n| `tx.result` | the focus transaction's result |","table":"table-0"},"21":{"id":"/docs/corpus/catalog-19","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"| `at`             | Resolves to                       |\n| ---------------- | --------------------------------- |\n| `tx.result_pair` | the result pair (hash and result) |","table":"table-0"},"22":{"id":"/docs/corpus/catalog-20","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"| `at`             | Resolves to     |\n| ---------------- | --------------- |\n| `tx.fee_charged` | the fee charged |","table":"table-0"},"23":{"id":"/docs/corpus/catalog-21","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"| `at`          | Resolves to                                                         |\n| ------------- | ------------------------------------------------------------------- |\n| `tx.envelope` | the envelope in the transaction set, in any phase, stage or cluster |","table":"table-0"},"24":{"id":"/docs/corpus/catalog-22","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"| `at`      | Resolves to            |\n| --------- | ---------------------- |\n| `tx.meta` | the transaction's meta |","table":"table-0"},"25":{"id":"/docs/corpus/catalog-23","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"| `at`                                     | Resolves to                        |\n| ---------------------------------------- | ---------------------------------- |\n| `tx.fee_processing`, `tx.post_apply_fee` | the fee and post-apply fee changes |","table":"table-0"},"26":{"id":"/docs/corpus/catalog-24","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"| `at`                                 | Resolves to                         |\n| ------------------------------------ | ----------------------------------- |\n| `op.meta`, `op.changes`, `op.events` | the focus operation inside the meta |","table":"table-0"},"27":{"id":"/docs/corpus/catalog-25","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"| `at`     | Resolves to                                      |\n| -------- | ------------------------------------------------ |\n| `ledger` | the whole ledger: header, upgrades, evicted keys |","table":"table-0"},"28":{"id":"/docs/corpus/catalog-26","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"A value may be `{\"$manifest\": \"contracts.kit2.CA1\"}`. It is then read from the run's own manifest, so a fact holds on every network even though contract ids differ by passphrase."},"29":{"id":"/docs/corpus/catalog-27","page_id":"/docs/corpus/catalog","tags":[],"type":"text","url":"/docs/corpus/catalog#fact-addresses","content":"<Callout title=\"Authoring aid\">`node tools/inspect.mjs <lane> <step> [variant]` reads a `make generate` run and prints the focus transaction's result and fee, and for each operation the kinds of its changes and its events.</Callout>"},"30":{"id":"/docs/corpus/entries/amount-payment-above-2-pow-53","page_id":"/docs/corpus/entries/amount-payment-above-2-pow-53","type":"page","content":"A payment of 9.5e15 stroops, above 2^53","breadcrumbs":["Docs","Corpus","Entries","Amounts"],"tags":[],"url":"/docs/corpus/entries/amount-payment-above-2-pow-53"},"31":{"id":"/docs/corpus/