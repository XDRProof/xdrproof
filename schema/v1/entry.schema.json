{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdrproof.dev/schema/v1/entry.schema.json",
  "title": "XDRProof corpus entry (v1.1)",
  "description": "One rare but valid ledger pattern, targeting named hazards from caps/registry.json. An entry has one or more variants (protocol x network passphrase x source lane), each a single raw XDR value with its own sha256. The RFP's required manifest fields map as follows: entry ID = id + variant key; CAP = caps; protocol version = variant.protocol; source = variant.source; synthetic flag = variant.synthetic; expected decoded values = expected.facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "pattern",
    "caps",
    "hazards",
    "xdr_type",
    "channel",
    "status",
    "variants",
    "expected"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120
    },
    "pattern": {
      "type": "string",
      "minLength": 40,
      "description": "What makes this shape rare and why readers break on it. Plain words."
    },
    "caps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(CAP-[0-9]{4}|pre-cap)$"
      }
    },
    "xdr_type": {
      "enum": [
        "LedgerCloseMeta",
        "TransactionEnvelope",
        "TransactionMeta",
        "LedgerEntry",
        "ScVal"
      ]
    },
    "sightings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "Upstream issues this entry reproduces."
    },
    "channel": {
      "enum": [
        "stable",
        "next",
        "embargoed"
      ],
      "description": "next = shapes from a protocol not yet on mainnet (advisory). embargoed = withheld until the affected project ships a fix; never committed publicly. Promotion changes channel, never the id."
    },
    "status": {
      "enum": [
        "active",
        "withdrawn"
      ]
    },
    "withdrawn_reason": {
      "type": "string"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decoded_as",
        "facts"
      ],
      "properties": {
        "decoded_as": {
          "const": "SEP-0051 JSON rendered by stellar-xdr 30.0.0",
          "description": "The JSON rendering fact paths point into. A rendering, not the truth: bytes are the truth."
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "sdk_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sdk_check"
          },
          "description": "Behaviour every SDK's helper layer must show on this entry; run by the conformance runner, not by verify."
        }
      }
    },
    "hazards": {
      "type": "array",
      "minItems": 1,
      "description": "Hazards (caps/registry.json) this entry targets, each with the place in the XDR where it appears.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "placement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^H-[A-H][0-9]+$"
          },
          "placement": {
            "type": "string",
            "minLength": 3,
            "description": "Type path where the hazard sits, e.g. SetOptionsOp.signer or ContractEvent.body.data"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "withdrawn_reason": true
        },
        "required": [
          "withdrawn_reason"
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 80,
      "description": "Permanent, human-meaningful, never reused or renamed, no protocol number."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "protocol",
        "network_passphrase",
        "file",
        "sha256",
        "size",
        "synthetic",
        "source",
        "focus"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^p[0-9]+-(mainnet|testnet|custom)-(generated|mined|synthetic)(-l[0-9]+)?(-[a-z0-9]+)?$",
          "description": "p<protocol>-<network>-<lane>, optional -l<ledger> for mined ledgers, optional -<flagset> for emitter-flag variants."
        },
        "protocol": {
          "type": "integer",
          "minimum": 1,
          "description": "Protocol version the bytes were emitted under."
        },
        "network_passphrase": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.xdr(\\.zst)?$",
          "description": "Raw XDR, or zstd-compressed raw XDR; size and sha256 describe the decompressed bytes."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "synthetic": {
          "type": "boolean",
          "description": "true when no stellar-core run we can point at produced these bytes."
        },
        "emittable": {
          "type": "boolean",
          "description": "For synthetic entries: whether core could emit this shape (it just was not captured)."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lane"
          ],
          "properties": {
            "lane": {
              "enum": [
                "generated",
                "mined",
                "synthetic"
              ]
            },
            "core_version": {
              "type": "string"
            },
            "emitter_flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ledger_seq": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Mined: the public SEP-0054 lake object."
            },
            "container_sha256": {
              "$ref": "#/$defs/sha256",
              "description": "Mined: sha256 of the decompressed lake object the bytes were cut from."
            },
            "recipe": {
              "type": "string",
              "description": "Generated: script and step that produced the transaction."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "lane": {
                    "const": "mined"
                  }
                },
                "required": [
                  "lane"
                ]
              },
              "then": {
                "properties": {
                  "url": true,
                  "ledger_seq": true,
                  "container_sha256": true
                },
                "required": [
                  "url",
                  "ledger_seq",
                  "container_sha256"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "lane": {
                    "const": "generated"
                  }
                },
                "required": [
                  "lane"
                ]
              },
              "then": {
                "properties": {
                  "core_version": true,
                  "recipe": true,
                  "ledger_seq": true
                },
                "required": [
                  "core_version",
                  "recipe",
                  "ledger_seq"
                ]
              }
            }
          ]
        },
        "change_order": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stable",
            "normalized_sha256",
            "runs",
            "raw"
          ],
          "description": "stellar-core emits some operation changes in a per-process random order. When it does, the entry pins the order-normalised content and lists every raw ordering observed; the shipped bytes are the most frequent one.",
          "properties": {
            "stable": {
              "type": "boolean"
            },
            "normalized_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "runs": {
              "type": "integer",
              "minimum": 1
            },
            "raw": {
              "type": "array",
              "minItems": 1,
              "description": "Every raw ordering observed, with how often; minority orderings ship as files.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "runs"
                ],
                "properties": {
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "runs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "file": {
                    "type": "string",
                    "pattern": "^[a-z0-9.-]+\\.xdr(\\.zst)?$"
                  }
                }
              }
            }
          }
        },
        "focus": {
          "description": "Where in the ledger the entry's pattern is: one transaction (and optionally one operation), or the ledger itself.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tx_hash"
              ],
              "properties": {
                "tx_hash": {
                  "$ref": "#/$defs/sha256"
                },
                "op_index": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ledger"
              ],
              "properties": {
                "ledger": {
                  "const": true
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "emittable": true
            },
            "required": [
              "emittable"
            ]
          }
        }
      ]
    },
    "evidence": {
      "enum": [
        "construction",
        "snapshot",
        "core",
        "walker",
        "review"
      ],
      "description": "construction = we built the transaction with this value; snapshot = SEP-0051 rendering by the pinned stellar-xdr crate; core = stellar-core's own decoder; walker = XDRProof's schema walker; review = a person checked it."
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "says",
        "evidence"
      ],
      "properties": {
        "says": {
          "type": "string",
          "minLength": 10,
          "description": "The fact in plain words."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Variant keys this fact applies to; all when absent."
        },
        "path": {
          "type": "string",
          "pattern": "^(/[^/]*)+$",
          "description": "JSON Pointer into the decoded JSON."
        },
        "equals": {
          "description": "Value at path must equal this."
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "description": "Array or object at path must have this many items."
        },
        "some": {
          "type": "object",
          "description": "Order-independent: at least one element of the array at path has all these sub-pointer values.",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(/[^/]*)+$"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "path": true,
            "equals": true
          },
          "required": [
            "path",
            "equals"
          ]
        },
        {
          "properties": {
            "path": true,
            "length": true
          },
          "required": [
            "path",
            "length"
          ]
        },
        {
          "properties": {
            "path": true,
            "some": true
          },
          "required": [
            "path",
            "some"
          ]
        }
      ]
    },
    "sdk_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "says",
        "helper",
        "path",
        "must"
      ],
      "properties": {
        "says": {
          "type": "string"
        },
        "helper": {
          "type": "string",
          "description": "Helper family, e.g. native-projection, asset-order, strkey-roundtrip."
        },
        "path": {
          "type": "string",
          "pattern": "^(/[^/]*)+$"
        },
        "must": {
          "type": "string",
          "description": "e.g. 'keep all 5 entries or reject; never silently drop'."
        }
      }
    }
  }
}
